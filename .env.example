APP_NAME=Telecom Manager
APP_ENV=local
APP_DEBUG=true
# In production, replace with a unique random key of at least 32 characters.
APP_SECRET_KEY=local-development-secret-key
# New production Compose profiles force HTTPS-only session cookies. Keep false
# only for the existing legacy HTTP setup on port 8000.
SESSION_COOKIE_SECURE=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telecom_manager
POSTGRES_USER=telecom_manager
# In production, replace with a unique random password of at least 24 characters.
POSTGRES_PASSWORD=telecom_manager_password

LOG_LEVEL=INFO

# self_hosted — client-owned server, cloud — shared Telecom Manager server.
HOSTING_MODE=self_hosted
CLOUD_TRIAL_DAYS=14
# Public cloud hostname. The app uses it to build canonical HTTPS payment URLs.
# Replace before enabling the optional HTTPS proxy profile.
CLOUD_DOMAIN=cloud.example.ru
# Recommended initial cloud subscription prices in rubles. A zero price keeps checkout disabled.
CLOUD_MONTHLY_PRICE=1490
CLOUD_YEARLY_PRICE=14900
CLOUD_PAYMENT_LINK_MINUTES=60
# Select exactly one independent payment shop for the cloud: yoomoney or robokassa.
CLOUD_PAYMENT_PROVIDER=yoomoney
# Shared per-IP limits; tune when many users are behind one NAT.
MOBILE_LOGIN_RATE_LIMIT=30
MOBILE_LOGIN_RATE_WINDOW_SECONDS=900
CLOUD_REGISTRATION_RATE_LIMIT=5
CLOUD_REGISTRATION_RATE_WINDOW_SECONDS=86400
# YooMoney wallet and secret for signed HTTP notifications.
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
# Optional legacy notification relay. Keep disabled for Telecom's independent shop.
# Never point this at PMGuard or share its wallet/callback without explicit approval.
YOOMONEY_FALLBACK_NOTIFICATION_URL=
YOOMONEY_FALLBACK_LABEL_PREFIXES=
# Separate Robokassa merchant. Never reuse PMGuard credentials or callback settings.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ANDROID_RELEASE_TAG=android-v1.1.1
# Optional override for hosting the APK elsewhere:
# ANDROID_APK_DOWNLOAD_URL=https://github.com/magomedov1009/telecom-manager/releases/download/android-v1.1.1/app-release.apk
# Set true only for a new installation to remove the historical sample providers once.
BOOTSTRAP_CLEAN_DEMO_PROVIDER_CATALOG=false
# Set true only for the first migration of a new, empty shared-cloud database.
BOOTSTRAP_CLEAN_CLOUD_DEFAULTS=false
SUPPORT_EMAIL=
