APP_NAME=Telecom Manager
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=local-development-secret-key

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telecom_manager
POSTGRES_USER=telecom_manager
POSTGRES_PASSWORD=telecom_manager_password

LOG_LEVEL=INFO

# self_hosted — client-owned server, cloud — shared Telecom Manager server.
HOSTING_MODE=self_hosted
CLOUD_TRIAL_DAYS=14
# Prices in rubles. A zero price keeps checkout disabled.
CLOUD_MONTHLY_PRICE=0
CLOUD_YEARLY_PRICE=0
CLOUD_PAYMENT_LINK_MINUTES=60
# YooMoney wallet and secret for signed HTTP notifications.
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
# Optional: forward signed notifications for labels not starting with TM to another project.
YOOMONEY_FALLBACK_NOTIFICATION_URL=
SUPPORT_EMAIL=
