[Unit]
Description=Create and validate a local Telecom Manager cloud database backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/telecom-manager-cloud/.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/telecom-manager-cloud
Environment=BACKUP_DIR=/opt/telecom-manager-cloud/backups
Environment=LOCAL_BACKUP_RETENTION_DAYS=30
UMask=0077
ExecStart=/bin/bash /opt/telecom-manager-cloud/scripts/backup-cloud.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/telecom-manager-cloud/backups

